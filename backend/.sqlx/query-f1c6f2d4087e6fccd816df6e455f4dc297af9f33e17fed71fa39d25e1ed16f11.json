  "query": "SELECT r.id, r.title, array_remove(array_agg(x.title_key), NULL) AS \"keys!\"\n             FROM release r\n             LEFT JOIN release_alias x ON x.release_id = r.id\n            WHERE r.artist_id = $1 AND r.merged_into IS NULL\n            GROUP BY r.id\n            ORDER BY r.id",
