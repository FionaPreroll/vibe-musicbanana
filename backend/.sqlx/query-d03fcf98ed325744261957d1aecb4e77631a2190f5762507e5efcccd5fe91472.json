  "db_name": "PostgreSQL",
  "query": "SELECT r.id, r.title, a.id AS artist_id, a.name AS artist, count(*) AS \"listens!\"\n                 FROM listen l\n                 JOIN recording r ON r.id = l.recording_id\n                 JOIN artist a ON a.id = r.artist_id\n                WHERE r.merged_into IS NULL\n                GROUP BY r.id, a.id\n                ORDER BY r.id",
