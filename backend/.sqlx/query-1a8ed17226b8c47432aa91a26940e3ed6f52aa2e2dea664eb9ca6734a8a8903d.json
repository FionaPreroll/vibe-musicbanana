  "query": "SELECT r.id, r.title, array_remove(array_agg(x.title_key), NULL) AS \"keys!\"\n             FROM recording r\n             LEFT JOIN recording_alias x ON x.recording_id = r.id\n            WHERE r.artist_id = $1 AND r.merged_into IS NULL\n            GROUP BY r.id\n            ORDER BY r.id",
