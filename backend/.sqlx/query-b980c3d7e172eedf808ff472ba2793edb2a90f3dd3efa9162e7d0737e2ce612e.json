  "query": "SELECT p.slug::text AS \"profile!\", a.username::text AS \"username!\", f.created_at,\n                  f.accepted_at\n             FROM follow f\n             JOIN profile p ON p.id = f.profile_id\n             JOIN account a ON a.id = f.follower_id\n            WHERE p.account_id = $1\n            ORDER BY p.slug, a.username",
