  "query": "SELECT a.id, a.name,\n                  EXISTS (SELECT FROM artist_alias x\n                           WHERE x.name_key = $2 AND x.artist_id = a.id) AS \"spelled!\"\n             FROM artist_mbid m\n             JOIN artist a ON a.id = m.artist_id\n            WHERE m.mbid = $1",
