  "query": "SELECT p.slug::text AS \"profile!\", t.label, t.created_at, t.last_used_at, t.revoked_at\n             FROM api_token t JOIN profile p ON p.id = t.profile_id\n            WHERE p.account_id = $1\n            ORDER BY t.created_at",
