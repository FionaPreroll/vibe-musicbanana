{
  "db_name": "PostgreSQL",
  "query": "SELECT t.id, p.slug::text AS \"profile!\", t.label, t.created_at, t.last_used_at\n             FROM api_token t\n             JOIN profile p ON p.id = t.profile_id\n            WHERE p.account_id = $1 AND t.revoked_at IS NULL\n            ORDER BY t.created_at DESC, t.id DESC",
