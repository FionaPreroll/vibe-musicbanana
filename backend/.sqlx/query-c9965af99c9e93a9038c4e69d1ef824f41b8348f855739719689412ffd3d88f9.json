  "query": "SELECT p.id, a.username::text AS \"username!\", p.slug::text AS \"slug!\", p.name\n             FROM profile p\n             JOIN account a ON a.id = p.account_id\n            WHERE a.username = $1::text::citext\n              AND p.slug = $2::text::citext\n              AND p.visibility = 'public'",
