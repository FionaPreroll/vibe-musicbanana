  "query": "SELECT a.username::text AS \"username!\", p.slug::text AS \"profile!\", f.created_at,\n                  f.accepted_at\n             FROM follow f\n             JOIN profile p ON p.id = f.profile_id\n             JOIN account a ON a.id = p.account_id\n            WHERE f.follower_id = $1\n            ORDER BY a.username, p.slug",
