  "query": "SELECT r.id, r.title AS name, r.merged_into,\n                  array(SELECT DISTINCT m.mbid FROM recording_mbid m WHERE m.recording_id = r.id) AS \"mbids!\"\n             FROM recording r\n            WHERE r.id IN ($1, $2)\n            ORDER BY r.id\n              FOR NO KEY UPDATE",
