  "query": "SELECT a.id, a.name, count(*) AS \"listens!\",\n                      EXISTS (SELECT FROM artist_mbid m WHERE m.artist_id = a.id) AS \"tagged!\"\n                 FROM listen l\n                 JOIN artist a ON a.id = l.artist_id\n                WHERE a.merged_into IS NULL\n                GROUP BY a.id\n                ORDER BY a.id",
