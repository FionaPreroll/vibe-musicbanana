# Password of musicbanana's own database. It ends up in a URL, so use letters and
# digits only, e.g. the output of `openssl rand -hex 24`.
MUSICBANANA_DB_PASSWORD=

# Port on this machine for the web interface and the scrobble API.
MUSICBANANA_PORT=3000

# Spotify plays from YourSpotify (README, "Spotify plays from YourSpotify"):
# remove the # in front of these lines and fill them in.
#COMPOSE_PROFILES=yourspotify
#YOURSPOTIFY_URL=http://192.168.1.10:8080
#YOURSPOTIFY_TOKEN=
#YOURSPOTIFY_USER=
